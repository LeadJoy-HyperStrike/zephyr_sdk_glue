/dts-v1/;

#include <hpmicro/hpm5151.dtsi>
#include "hpm5100evk-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <zephyr/dt-bindings/adc/adc.h>
#include <zephyr/dt-bindings/i2c/i2c.h>
#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	model = "HPMicro HPM5151EVK";
	compatible = "HPMicro,hpm5100evk";

	aliases {
		led0 = &led_r;
		sw0 = &pbutn;
		adc0 = &adc0;
		i2c-0 = &i2c1;
		pwm-0 = &pwm3;
		pwm-led0 = &pwm_led0;
		pwm-led1 = &pwm_led1;
		counter0 = &gptmr0;
	};

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,flash = &flash0;
		zephyr,sram = &hram;
		zephyr,itcm = &ilm;
		zephyr,dtcm = &dlm;
		zephyr,code-partition = &slot0_partition;
		zephyr,flash-controller = &xpi0;
		zephyr,canbus = &mcan0;
	};

	leds {
		compatible = "gpio-leds";
		led_r: led_r {
			gpios = <&gpioa 18 (GPIO_ACTIVE_LOW)>;
			label = "LED";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";
		pbutn: pbutn {
			/* Match sdk board.h BOARD_APP_GPIO_PIN = PA15 (USER KEY). */
			gpios = <&gpioa 15 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	/*
	 * BOARD_APP_PWM_OUT1/2 = PWM3 ch0/ch1 on PA16/PA17.
	 */
	pwmleds {
		compatible = "pwm-leds";
		pwm_led0: pwm_led_0 {
			pwms = <&pwm3 0 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "PWM3_CH0_PA16";
		};
		pwm_led1: pwm_led_1 {
			pwms = <&pwm3 1 PWM_MSEC(20) PWM_POLARITY_NORMAL>;
			label = "PWM3_CH1_PA17";
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart0>;
	pinctrl-names = "default";
	wakeup-source;
	/* Async RX idle: on-chip UART RX-line idle (same UART IRQ). */
	dmas = <&hdma0 0 8>, <&hdma0 1 9>;
	dma-names = "rx", "tx";
};

/*
 * Stop-mode serial wake input. Connect an external 3.3V USB-UART adapter:
 * adapter RX <- PY00, adapter TX -> PY01, and common GND. PY00/PY01 are
 * unavailable to SOC I2C0 while PUART is enabled.
 */
&puart {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_puart>;
	pinctrl-names = "default";
	wakeup-source;
};

/*
 * UART1–3: SoC nodes + board pinmux ready; keep disabled by default.
 * Enable with status="okay" when needed (see UART_NOTES.md).
 */
&uart1 {
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart1>;
	pinctrl-names = "default";
	status = "disabled";
};

&uart2 {
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart2>;
	pinctrl-names = "default";
	/* HDMA mux UART2 RX/TX = 0xC/0xD; pick free HDMA0/HDMA1 channels if enabling async. */
	status = "disabled";
};

&uart3 {
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart3>;
	pinctrl-names = "default";
	/* HDMA mux UART3 RX/TX = 0xE/0xF */
	status = "disabled";
};

&gpioa {
	pinctrl-0 = <&pinmux_gpioa>;
	pinctrl-names = "default";
	status = "okay";
};

&hdma0 {
	status = "okay";
};

/* Second AHB DMA (UM HDMA1). Enable when channel budget on HDMA0 is tight. */
&hdma1 {
	status = "disabled";
};

/*
 * BOARD_APP_I2C = I2C1 (PY03 SCL / PY02 SDA).
 */
&i2c1 {
	status = "okay";
	pinctrl-0 = <&pinmux_i2c1>;
	pinctrl-names = "default";
	clock-frequency = <I2C_BITRATE_STANDARD>;
};

/*
 * BOARD_GPTMR = GPTMR0 CH0 (internal counter / reload IRQ; no pinmux).
 */
&gptmr0 {
	status = "okay";
};

/*
 * PMIC-domain GPTMRv2. Owns the Zephyr sysclock so kernel timeouts can
 * wake Stop (Andes mtimer is in the CPU domain and stops there).
 */
&ptmr {
	status = "okay";
	wakeup-source;
	sys-clock;
};

&mtimer {
	status = "disabled";
};

/*
 * BOARD_APP_SPI = SPI3 (PC06 CS / PC10 SCLK / PC13 MOSI / PC15 MISO).
 * Short MOSI-MISO for loopback. MISO(PC15) shares ADC path — high SPI
 * clocks may need the ADC-side capacitor removed (SDK README).
 */
&spi3 {
	status = "okay";
	pinctrl-0 = <&pinmux_spi3>;
	pinctrl-names = "default";
	/* HDMA0 ch6/7: avoid UART0(0/1) and SoC I2S defaults(2-5). Mux SPI3 RX/TX. */
	dmas = <&hdma0 6 0x6>, <&hdma0 7 0x7>;
	dma-names = "rx", "tx";
};

/*
 * BOARD_APP_PWM = PWM3 (PA16 OUT1 / PA17 OUT2). Scope PA16 for duty/period.
 */
&pwm3 {
	status = "okay";
	period-init = <50>;
	dead-zone-in-half-cycle = <0>;
	pinctrl-0 = <&pinmux_pwm3>;
	pinctrl-names = "default";
};

&xpi0 {
	status = "okay";
	flash0: flash@0 {
		compatible = "hpmicro,hpmicro-flash", "soc-nv-flash";
		reg = <0x80000000 DT_SIZE_M(1)>;
		status = "okay";
		erase-block-size = <4096>;
		write-block-size = <1>;
		nor-cfg-opt-hdr = <0xfcf90002>;
		nor-cfg-opt-opt0 = <0x05>;
		nor-cfg-opt-opt1 = <0x1000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;

			boot_partition: partition@0 {
				label = "mcuboot";
				reg = <0x3000 0x20000>;
			};

			slot0_partition: partition@23000 {
				label = "image-0";
				reg = <0x23000 DT_SIZE_K(384)>;
			};

			slot1_partition: partition@83000 {
				label = "image-1";
				reg = <0x83000 DT_SIZE_K(384)>;
			};

			scratch_partition: partition@E3000 {
				label = "image-scratch";
				reg = <0xE3000 DT_SIZE_K(64)>;
			};

			/* 1MB flash ends at 0x100000; 0xF3000+64K would overflow. */
			storage_partition: partition@F3000 {
				label = "storage";
				reg = <0xF3000 0xD000>;
			};
		};
	};
};

&usb0 {
	pinctrl-0 = <&pinmux_usb0>;
	pinctrl-names = "default";
};

zephyr_udc0: &usb0 {
	compatible = "hpmicro,hpm-udc";
	status = "disabled";
};

/*
 * Default app ADC: PC05 / ADC0 channel 2 (sdk BOARD_APP_ADC16_CH_1).
 * Used by samples/drivers/adc/adc_dt via zephyr,user io-channels.
 */
/ {
	zephyr,user {
		io-channels = <&adc0 2>;
	};
};

&adc0 {
	status = "okay";
	pinctrl-0 = <&pinmux_adc0>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@2 {
		reg = <2>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <12>;
	};
};

/*
 * BOARD_APP_CAN = MCAN0 (PA19 TX / PA20 RX).
 * Internal loopback does not need a transceiver.
 */
&mcan0 {
	status = "okay";
	pinctrl-0 = <&pinmux_mcan0>;
	pinctrl-names = "default";
};
