/dts-v1/;

#include <hpmicro/hpm6e80.dtsi>
#include "hpm6e00evk-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>

/ {
	model = "HPMicro HPM6E00EVK";
	compatible = "HPMicro,hpm6e00evk";

	aliases {
		led0 = &led_r;
		led1 = &led_g;
		led2 = &led_b;
		sw0 = &pbutn;
		eeprom-0 = &eeprom;
	};

	chosen {
		zephyr,console = &uart0;
		zephyr,shell-uart = &uart0;
		zephyr,sram = &sram;
		zephyr,flash = &flash0;
		zephyr,itcm = &ilm;
		zephyr,dtcm = &dlm;
		zephyr,flash-controller = &xpi0;
	};

	dram: memory@40000000 {
		device_type = "memory";
		reg = <0x40000000 DT_SIZE_M(32)>;
	};

	leds {
		compatible = "gpio-leds";
		led_r: led_r {
			gpios = <&gpioe 14 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "LEDR";
		};
		led_g: led_g {
			gpios = <&gpioe 15 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "LEDG";
		};
		led_b: led_b {
			gpios = <&gpioe 4 (GPIO_PULL_DOWN | GPIO_ACTIVE_HIGH)>;
			label = "LEDB";
		};
	};

	gpio_keys {
		compatible = "gpio-keys";
		pbutn: pbutn {
			gpios = <&gpiob 24 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
		wbutn: wbutn {
			gpios = <&gpiob 25 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_1>;
		};
	};
};

&uart0 {
	status = "okay";
	current-speed = <115200>;
	pinctrl-0 = <&pinmux_uart0>;
	pinctrl-names = "default";
	/*
	 * UART-idle detection plumbing, consumed only by CONFIG_UART_ASYNC_API
	 * (not enabled by this product). The register bases and the GPTMR clock
	 * id below are fixed for HPM6E80 -- the previous values were HPM6750
	 * leftovers (TRGM2/GPTMR4 bases, garbled clock id). The four TRGM
	 * routing numbers are still HPM6750 values: on HPM6E80 output 0x37/0x38
	 * are ADCX_PTRGI1A/1B (ADC preemption triggers!), and the real GPTMR4
	 * targets are IN2=0x74 / IN3=0x75 / SYNCI=0x76 (hpm_trgmmux_src.h).
	 * Redesign the whole route against the HPM6E80 TRGM0 tables before
	 * enabling the async API on this board.
	 */
	uart-idle-trgm-reg = <0xF047C000>;     /* HPM_TRGM0_BASE (only TRGM on HPM6E80) */
	uart-idle-trgm-pin = <115>;            /* HPM6750 leftover, see note above */
	uart-idle-trgm-input-src = <0x0B>;     /* HPM6750 leftover, see note above */
	uart-idle-trgm-output-gptmr-in = <0x38>;   /* HPM6750 leftover, see note above */
	uart-idle-trgm-output-gptmr-sync = <0x37>; /* HPM6750 leftover, see note above */
	uart-idle-gptmr-reg = <0xF0010000>;    /* HPM_GPTMR4_BASE */
	uart-idle-gptmr-clock-name = <17629197>; /* CLOCK_GPTMR4 (dt-bindings hpm6e80-clocks.h) */
	dmas = <&hdma 0 8>, <&hdma 1 9>;
	dma-names = "rx", "tx";
};

&gpioa {
	pinctrl-0 = <&pinmux_gpioa>;
	pinctrl-names = "default";
	status = "okay";
};

&gpiob {
	pinctrl-0 = <&pinmux_gpiob>;
	pinctrl-names = "default";
	status = "okay";
};

&gpioe {
	pinctrl-0 = <&pinmux_gpioe>;
	pinctrl-names = "default";
	status = "okay";
};

&gpiof {
	pinctrl-0 = <&pinmux_gpiof>;
	pinctrl-names = "default";
	status = "okay";
};

&gpioz {
	pinctrl-0 = <&pinmux_gpioz>;
	pinctrl-names = "default";
	status = "okay";
};

&gpioy {
	pinctrl-0 = <&pinmux_gpioy>;
	pinctrl-names = "default";
	status = "okay";
};

&i2c1 {
	status = "disabled";
	pinctrl-0 = <&pinmux_i2c1>;
	pinctrl-names = "default";

	eeprom: eeprom@50 {
		compatible = "atmel,at24";
		status = "disabled";
		reg = <0x50>;
		size = <16384>;
		address-width = <16>;
		timeout = <25>;
		pagesize = <64>;
	};
};
&spi7 {
	status = "disabled";
	pinctrl-0 = <&pinmux_spi7>;
	pinctrl-names = "default";
	cs-gpios = <&gpiof 27 GPIO_ACTIVE_LOW>;
	/* HDMA channels 0 and 1, muxed to SPI7 RX and TX (hpm_dmamux_src.h:
	 * HPM_DMA_SRC_SPI7_RX=0x22, _TX=0x23). Was 4/5 = SPI2's request ids,
	 * copied from another board's spi node. */
	dmas = <&hdma 0 34>, <&hdma 1 35>;
	dma-names = "rx", "tx";
};
&hdma {
	status = "okay";
};

&xdma {
	status = "okay";
};

&xpi0 {
	status = "okay";
	flash0: flash@0 {
		compatible = "hpmicro,hpmicro-flash", "soc-nv-flash";
		reg = <0x80000000 DT_SIZE_M(16)>;
		status = "okay";
		erase-block-size = <4096>;
		write-block-size = <1>;
		nor-cfg-opt-hdr = <0xfcf90001>;
		nor-cfg-opt-opt0 = <0x05>;
		nor-cfg-opt-opt1 = <0x1000>;

		partitions {
			compatible = "fixed-partitions";
			#address-cells = <1>;
			#size-cells = <1>;
			/*
			 * ROM-native dual image (spec 2026-09-02 v2 §3.1). Each slot is a
			 * complete boot image: EXIP key blob @+0, XPI option @+0x400, ROM
			 * container header @+0x1000, firmware @+0x3000. The last 4 KB
			 * sector of each slot holds the app's slot-state record; the ROM
			 * never hashes it and no EXIP region covers it. OTP word 25 = 8
			 * puts image 1 at 0x200000; storage sits above both.
			 */
			slot0_partition: partition@0 {
				label = "image-0";
				reg = <0x0 0x1c0000>;
			};

			slot1_partition: partition@200000 {
				label = "image-1";
				reg = <0x200000 0x1c0000>;
			};

			storage_partition: partition@3c0000 {
				label = "storage";
				reg = <0x3c0000 0x40000>;
			};
		};
	};
};

&usb0 {
	pinctrl-0 = <&pinmux_usb0>;
	pinctrl-names = "default";
};

zephyr_udc0: &usb0 {
	compatible = "hpmicro,hpm-udc";
	status = "disabled";
};

&eth0 {
    pinctrl-0 = <&pinmux_eth_rgmii>;
    pinctrl-names = "default";
	phy-addr = <2>; /* rtl8211e */
	reset-gpios = <&gpioa 14 GPIO_ACTIVE_LOW>;
    status = "disabled";
};
