/dts-v1/;
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <dt-bindings/clock/hpmicro-clocks.h>
#include <dt-bindings/clock/hpm5151-clocks.h>
#include <mem.h>
#include <freq.h>

/ {
	#address-cells = <1>;
	#size-cells = <1>;

	cpus {
		#address-cells = <1>;
		#size-cells = <0>;
		cpu0: cpu@0 {
			compatible = "andestech,andescore-d25", "riscv";
			reg = <0>;
			status = "okay";
			riscv,isa = "rv32gc_xandes";
			i-cache-line-size = <64>;
			d-cache-line-size = <64>;

			cpu0_intc: interrupt-controller {
				compatible = "riscv,cpu-intc";
				#address-cells = <0>;
				#interrupt-cells = <1>;
				interrupt-controller;
			};
		};
	};

	clocks {
		osc24: osc24 {
			#clock-cells = <2>;
			compatible = "hpmicro,hpm-src-clock";
		};

		osc32: osc32 {
			#clock-cells = <2>;
			compatible = "hpmicro,hpm-src-clock";
		};

		pll0: pll0 {
			#clock-cells = <2>;
			compatible = "hpmicro,hpm-pllv2-clock";
			pll-frequency = <DT_FREQ_M(720)>;
			pll-index = <0>;

			clk0 {
				src-name = <CLK_SRC_PLL0_CLK0>;
				div-i = <0>;
				div-p = <0>;
			};

			clk1 {
				src-name = <CLK_SRC_PLL0_CLK1>;
				div-i = <1>;
				div-p = <1>;
			};
		};

		/*
		 * Do NOT declare pll1 as hpmicro,hpm-pllv2-clock here.
		 * That driver calls sysctl_clock_set_preset() on every PLL
		 * instance; a second PLL node resets the clock tree after
		 * pll0/soc bring-up and yields a silent board (no UART).
		 * ADC ANA uses CLK_SRC_PLL1_CLK0 from BootROM (≈400MHz).
		 */
	};

	soc {
		#address-cells = <1>;
		#size-cells = <1>;
		compatible = "hpmicro,hpm51xx";
		ranges;

		clk: clock-controller@f40c0000 {
			compatible = "hpmicro,hpm-clock";
			reg = <0xf4000000 DT_SIZE_K(256)
				0xf40c0000 DT_SIZE_K(256)>;
			reg-names = "sysctl", "pll";
			#clock-cells = <3>;
			status = "okay";
		};

		ilm: memory@0 {
			compatible = "zephyr,memory-region";
			reg = <0x0 DT_SIZE_K(256)>;
			zephyr,memory-region = "ITCM";
		};

		dlm: memory@200000 {
			compatible = "zephyr,memory-region";
			reg = <0x00200000 DT_SIZE_K(128)>;
			zephyr,memory-region = "DTCM";
		};

		hram: memory@f0200000 {
			compatible = "zephyr,memory-region";
			reg = <0xF0200000 DT_SIZE_K(32)>;
			zephyr,memory-region = "SRAM";
		};

		plic: interrupt-controller@e4000000 {
			compatible = "sifive,plic-1.0.0";
			#address-cells = <1>;
			#interrupt-cells = <2>;
			interrupt-controller;
			reg = <0xe4000000 0x00001000
				0xe4002000 0x00000800
				0xe4200000 0x00010000>;
			reg-names = "prio", "irq_en", "reg";
			riscv,max-priority = <7>;
			riscv,ndev = <72>;
			interrupts-extended = <&cpu0_intc 11>;
		};

		plic_sw: interrupt-controller@e6400000 {
			compatible = "andestech,plic_sw";
			#address-cells = <1>;
			#interrupt-cells = <2>;
			interrupt-controller;
			reg = <0xe6400000 0x00400000>;
			interrupts-extended = <&cpu0_intc 3>;
		};

		mtimer: machine-timer@e6000000 {
			compatible = "andestech,machine-timer";
			reg = <0xe6000000 0x1
				0xe6000008 0x1>;
			interrupts-extended = <&cpu0_intc 7>;
		};

		xpi0: xpi@f00e0000 {
			compatible = "hpmicro,xpi";
			reg = <0xf00e0000 DT_SIZE_K(16)>;
			#address-cells = <1>;
			#size-cells = <1>;
			status = "disabled";
		};

		gpio0: peripheral@f00d0000 {
			#address-cells = <1>;
			#size-cells = <1>;
			ranges = <0x0 0xf00d0000 DT_SIZE_K(16)>;
		};

		uart0: serial@f0040000 {
			compatible = "hpmicro,hpm-uart";
			reg = <0xf0040000 DT_SIZE_K(16)>;
			interrupts = <8 1>, <7 1>;
			interrupt-names = "uart", "idletimer";
			clocks = <&clk CLOCK_UART0 CLK_SRC_OSC24M 1>;
			interrupt-parent = <&plic>;
			status = "disabled";
		};

		uart1: serial@f0044000 {
			compatible = "hpmicro,hpm-uart";
			reg = <0xf0044000 DT_SIZE_K(16)>;
			interrupts = <9 1>, <7 1>;
			interrupt-names = "uart", "idletimer";
			clocks = <&clk CLOCK_UART1 CLK_SRC_OSC24M 1>;
			interrupt-parent = <&plic>;
			status = "disabled";
		};

		i2c0: i2c@f0060000 {
			compatible = "hpmicro,hpm-i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&clk CLOCK_I2C0 CLK_SRC_OSC24M 1>;
			clock-frequency = <100000>;
			reg = <0xf0060000 DT_SIZE_K(16)>;
			interrupts = <12 1>;
			interrupt-parent = <&plic>;
			status = "disabled";
		};

		i2c1: i2c@f0064000 {
			compatible = "hpmicro,hpm-i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&clk CLOCK_I2C1 CLK_SRC_OSC24M 1>;
			clock-frequency = <100000>;
			reg = <0xf0064000 DT_SIZE_K(16)>;
			interrupts = <13 1>;
			interrupt-parent = <&plic>;
			status = "disabled";
		};

		i2c2: i2c@f0068000 {
			compatible = "hpmicro,hpm-i2c";
			#address-cells = <1>;
			#size-cells = <0>;
			clocks = <&clk CLOCK_I2C2 CLK_SRC_OSC24M 1>;
			clock-frequency = <100000>;
			reg = <0xf0068000 DT_SIZE_K(16)>;
			interrupts = <14 1>;
			interrupt-parent = <&plic>;
			status = "disabled";
		};

		spi0: spi@f0070000 {
			compatible = "hpmicro,hpm-spi";
			reg = <0xf0070000 DT_SIZE_K(16)>;
			clocks = <&clk CLOCK_SPI0 CLK_SRC_OSC24M 1>;
			interrupts = <15 1>;
			interrupt-parent = <&plic>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
			cs-sck-delay = <3>;
			cs-minimum-high-time = <11>;
		};

		spi1: spi@f0074000 {
			compatible = "hpmicro,hpm-spi";
			reg = <0xf0074000 DT_SIZE_K(16)>;
			clocks = <&clk CLOCK_SPI1 CLK_SRC_OSC24M 1>;
			interrupts = <16 1>;
			interrupt-parent = <&plic>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
			cs-sck-delay = <3>;
			cs-minimum-high-time = <11>;
		};

		spi2: spi@f0078000 {
			compatible = "hpmicro,hpm-spi";
			reg = <0xf0078000 DT_SIZE_K(16)>;
			clocks = <&clk CLOCK_SPI2 CLK_SRC_OSC24M 1>;
			interrupts = <17 1>;
			interrupt-parent = <&plic>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
			cs-sck-delay = <3>;
			cs-minimum-high-time = <11>;
		};

		spi3: spi@f007c000 {
			compatible = "hpmicro,hpm-spi";
			reg = <0xf007c000 DT_SIZE_K(16)>;
			clocks = <&clk CLOCK_SPI3 CLK_SRC_OSC24M 1>;
			interrupts = <18 1>;
			interrupt-parent = <&plic>;
			status = "disabled";
			#address-cells = <1>;
			#size-cells = <0>;
			cs-sck-delay = <3>;
			cs-minimum-high-time = <11>;
		};

		i2s0: i2s@f0140000 {
			compatible = "hpmicro,hpm-i2s";
			reg = <0xf0140000 DT_SIZE_K(16)>;
			clocks = <&clk CLOCK_I2S0 CLK_I2S_SRC_AUD0 1>;
			dmas = <&hdma 2 0x18>, <&hdma 3 0x14>;
			dma-names = "tx", "rx";
			interrupts = <33 1>;
			interrupt-parent = <&plic>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		i2s1: i2s@f0144000 {
			compatible = "hpmicro,hpm-i2s";
			reg = <0xf0144000 DT_SIZE_K(16)>;
			clocks = <&clk CLOCK_I2S1 CLK_I2S_SRC_AUD1 1>;
			dmas = <&hdma 4 0x20>, <&hdma 5 0x1c>;
			dma-names = "tx", "rx";
			interrupts = <34 1>;
			interrupt-parent = <&plic>;
			#address-cells = <1>;
			#size-cells = <0>;
			status = "disabled";
		};

		pinctrl: pin-controller@f4040000 {
			compatible = "hpmicro,hpm-pinctrl";
			reg = <0xf4040000 0x4000>;
			status = "okay";
		};

		pinctrl_pioc: pin-controller@f4118000 {
			compatible = "hpmicro,hpm-pinctrl";
			reg = <0xf4118000 0x4000>;
			status = "okay";
		};

		hdma: hdma@f00c8000 {
			#dma-cells = <2>;
			compatible = "hpmicro,hpm-dmav2";
			dma-channels = <8>;
			dma-requests = <61>; /* hpm_dmamux_src.h: 0x00..0x3C */
			reg = <0xf00c8000 0x4000>,
				<0xf00c4000 0x4000>;
			/* hpm_soc_irq.h: IRQn_HDMA0 = 24. The vendor drop had 34,
			 * which is IRQn_I2S1 -- HDMA completions would have been
			 * routed to the wrong PLIC line (and collided with &i2s1,
			 * whose node legitimately uses 34).
			 */
			interrupts = <24 1>;
			interrupt-parent = <&plic>;
			status = "disabled";
		};

		usb0: usb@f00f0000 {
			clk-name = <CLOCK_USB0>;
			reg = <0xf00f0000 0x4000>;
			interrupts = <43 1>;
			interrupt-parent = <&plic>;
			num-bidir-endpoints = <16>;
			status = "disabled";
		};

		adc0: adc@f0100000 {
			compatible = "hpmicro,hpm-adc16";
			reg = <0xf0100000 DT_SIZE_K(16)>;
			interrupts = <25 1>;
			interrupt-parent = <&plic>;
			/* ANA0 ← PLL1_CLK0/2 (BootROM PLL1 ≈400MHz). Prefer AHB for
			 * bring-up if ANA hangs; SDK sample uses bus clock by default.
			 */
			clocks = <&clk CLOCK_ADC0 CLK_ADC_SRC_AHB0 1>,
				 <&clk CLOCK_ANA0 CLK_SRC_PLL1_CLK0 2>;
			sample-time = <20>;
			status = "disabled";
			#io-channel-cells = <1>;
		};

		adc1: adc@f0104000 {
			compatible = "hpmicro,hpm-adc16";
			reg = <0xf0104000 DT_SIZE_K(16)>;
			interrupts = <26 1>;
			interrupt-parent = <&plic>;
			clocks = <&clk CLOCK_ADC1 CLK_ADC_SRC_AHB0 1>,
				 <&clk CLOCK_ANA1 CLK_SRC_PLL1_CLK0 2>;
			sample-time = <20>;
			status = "disabled";
			#io-channel-cells = <1>;
		};

		adc2: adc@f0108000 {
			compatible = "hpmicro,hpm-adc16";
			reg = <0xf0108000 DT_SIZE_K(16)>;
			interrupts = <27 1>;
			interrupt-parent = <&plic>;
			clocks = <&clk CLOCK_ADC2 CLK_ADC_SRC_AHB0 1>,
				 <&clk CLOCK_ANA2 CLK_SRC_PLL1_CLK0 2>;
			sample-time = <20>;
			status = "disabled";
			#io-channel-cells = <1>;
		};

		adc3: adc@f010c000 {
			compatible = "hpmicro,hpm-adc16";
			reg = <0xf010c000 DT_SIZE_K(16)>;
			interrupts = <28 1>;
			interrupt-parent = <&plic>;
			clocks = <&clk CLOCK_ADC3 CLK_ADC_SRC_AHB0 1>,
				 <&clk CLOCK_ANA3 CLK_SRC_PLL1_CLK0 2>;
			sample-time = <20>;
			status = "disabled";
			#io-channel-cells = <1>;
		};
	};
};

&gpio0 {
	gpioa: gpio@0 {
		compatible = "hpmicro,hpm-gpio";
		reg = <0x0 0x4000>;
		gpio-controller;
		#gpio-cells = <2>;
		hpmicro-gpio-port = <0>;
		interrupts = <1 1>;
		interrupt-parent = <&plic>;
	};

	gpiob: gpio@1 {
		compatible = "hpmicro,hpm-gpio";
		reg = <0x0 0x4000>;
		gpio-controller;
		#gpio-cells = <2>;
		hpmicro-gpio-port = <1>;
		interrupts = <2 1>;
		interrupt-parent = <&plic>;
	};

	gpioc: gpio@2 {
		compatible = "hpmicro,hpm-gpio";
		reg = <0x0 0x4000>;
		gpio-controller;
		#gpio-cells = <2>;
		hpmicro-gpio-port = <2>;
		interrupts = <3 1>;
		interrupt-parent = <&plic>;
		status = "disabled";
	};

	gpiox: gpio@3 {
		compatible = "hpmicro,hpm-gpio";
		reg = <0x0 0x4000>;
		gpio-controller;
		#gpio-cells = <2>;
		hpmicro-gpio-port = <13>;
		interrupt-parent = <&plic>;
		interrupts = <4 1>;
		status = "disabled";
	};

	gpioy: gpio@4 {
		compatible = "hpmicro,hpm-gpio";
		reg = <0x0 0x4000>;
		gpio-controller;
		#gpio-cells = <2>;
		hpmicro-gpio-port = <14>;
		interrupts = <5 1>;
		interrupt-parent = <&plic>;
		status = "disabled";
	};
};
