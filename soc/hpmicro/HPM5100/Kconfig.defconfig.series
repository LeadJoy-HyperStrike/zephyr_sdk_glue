if SOC_SERIES_HPM5100

config SOC_SERIES
	default "HPM5100"

config SYS_CLOCK_HW_CYCLES_PER_SEC
	default 24000000

config KERNEL_ENTRY
	default "_start"

config RISCV_GENERIC_TOOLCHAIN
	default y if "$(ZEPHYR_TOOLCHAIN_VARIANT)" = "zephyr"
	default n

config ICACHE
	default y

config DCACHE
	default y

config RISCV_SOC_INTERRUPT_INIT
	default y

config RISCV_GP
	default y

config 2ND_LVL_ISR_TBL_OFFSET
	# PLIC parent IRQ is 11 on HPM5100; keep table offset aligned
	# with 2ND_LVL_INTR_00_OFFSET to avoid negative aggregator index.
	default 11

config 2ND_LVL_INTR_00_OFFSET
	default 11

config MAX_IRQ_PER_AGGREGATOR
	default 127

config NUM_IRQS
	# Must cover 2ND_LVL_ISR_TBL_OFFSET + PLIC ndev (72), otherwise
	# plic_irq_handler can index past _sw_isr_table and corrupt RAM
	# (timeout_list sits immediately before the ISR table).
	default 83

source "${ZEPHYR_SDK_GLUE_MODULE_DIR}/soc/hpmicro/HPM5100/Kconfig.defconfig.HPM51*"

endif # SOC_SERIES_HPM5100
