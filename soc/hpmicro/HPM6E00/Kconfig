config SOC_ANDES_V5_HWDSP
	bool "AndeStar V5 DSP ISA"
	select RISCV_SOC_CONTEXT_SAVE
	depends on !RISCV_GENERIC_TOOLCHAIN
	help
		This option enables the AndeStar v5 hardware DSP, in order to
		support using the DSP instructions.

config SOC_ANDES_V5_PMA
	bool "Andes V5 Physical Memory Attribute (PMA)"
	default y
	select ARCH_HAS_NOCACHE_MEMORY_SUPPORT
	select HAS_HPMSDK_PMP
	help
		This option enables the Andes V5 PMA, in order to support SW to
		configure physical memory attribute by PMA CSRs. The address
		matching of Andes V5 PMA is like RISC-V PMP NAPOT mode
		(power-of-two alignment).

config HPM_SOC_CPU_FREQ_MHZ
	int "CPU0/CPU1 core frequency (MHz)"
	default 600
	range 24 600
	help
		PLL0 VCO frequency; CPU0 and CPU1 both run from PLL0CLK0 with
		postdiv 1.0 and divider 1, so this is the core clock.

		Safe to retune in isolation: per UM V0.8's default clock source
		table, of the 73 CLK_TOP_* domains only CLK_TOP_CPU0 and
		CLK_TOP_CPU1 are sourced from PLL0CLK0. AHB0, XPI0 (the XIP
		flash!) and 57 other domains sit on PLL1CLK0 and are unaffected,
		so the ADC convert-clock ceiling (RM 71.2.1.1) does not move.

		Must be a whole multiple of the 24 MHz crystal or
		pllctlv2_init_pll_with_freq() lands on a fractional MFN.

		WARNING: the core1 8 kHz engine budget is 94 us (XInput) / 96 us
		(DS4) of a 125 us period at 600 MHz. Scaling is roughly linear
		for ITCM-resident work, so 480 MHz leaves single-digit
		microseconds of margin. Re-measure the hot path before shipping
		anything below 600.

config HPM_SOC_GATE_UNUSED_CLOCKS
	bool "Leave unused peripheral clocks gated at boot"
	default y
	help
		soc_init_clock() otherwise ungates the entire motor-control
		island (QEI/QEO/RDC/MTG/VSC/CLC/PLB/SEI/EMDS), PWM1-3 and PTPC
		on every boot. None of those has an enabled devicetree node on
		the boards this fork carries, so clocking them is static power
		for nothing.

		PWM0 is NOT covered by this option: it is the ADC TRGO source
		(trigger-pwm in the board overlays) and stays ungated always.

		Set n to restore the stock HPMicro behaviour, e.g. when bringing
		up a board that does use the motor peripherals.

endif # SOC_SERIES_HPM6E00