DT_COMPAT_HPM_UDC := hpmicro,hpm-udc

config UDC_HPMICRO
	bool "HPMicro USB Device controller driver"
	default y
	depends on DT_HAS_HPMICRO_HPM_UDC_ENABLED
	select HAS_HPMSDK_USB
	select NOCACHE_MEMORY if ARCH_HAS_NOCACHE_MEMORY_SUPPORT
	help
	  Enable support for hpmicro usb device driver.
	  Transfer buffers are allocated from nocache memory: without
	  CONFIG_NOCACHE_MEMORY the driver DMAs straight into cached net_buf
	  data with no cache maintenance, which corrupts transfers on
	  D-cache-enabled parts.

config UDC_HPM_LATENCY_HOOK
	bool "HS2 latency instrumentation hook in the UDC ISR"
	default n
	depends on UDC_HPMICRO
	help
	  Timestamp udc_hpm_isr() entry with the mcycle CSR and call the weak
	  hs2_udc_lat_completion() hook for every completed endpoint. Read-only
	  diagnostics; adds ~20 cycles per completion.

config UDC_HPM_FASTPATH
	bool "HS2 single-endpoint IN fast path (direct ISR completion)"
	default n
	depends on UDC_HPMICRO
	select UDC_HPM_LATENCY_HOOK
	help
	  Allow the application to claim one IN endpoint whose completions are
	  delivered directly from the UDC ISR (with an mcycle timestamp) and
	  which is re-armed by a register-level prime, bypassing the usbd
	  thread and class layer. Used by the HS2 8 kHz phase-locked gamepad
	  stream.